# .pre-commit-config.yaml.example
#
# Copy to .pre-commit-config.yaml in your repository, then:
#   pipx install pre-commit   # or: pip install pre-commit
#   pre-commit install
#   pre-commit run --all-files
#
# Pick ONE of the two blocks below.

# --- Option A: consume LeakHound from its own repo (recommended) -------------
# Pin `rev` to a tag or commit SHA of the LeakHound repository.
repos:
  - repo: https://example.invalid/your-org/leakhound
    rev: v2.4.1
    hooks:
      - id: leakhound

# --- Option B: wire an existing local copy of leakhound.sh directly ----------
# Use this when leakhound.sh already lives in your repo (e.g. ./leakhound.sh).
# `language: system` runs it from your PATH / working tree, so no clone happens.
#
# repos:
#   - repo: local
#     hooks:
#       - id: leakhound
#         name: LeakHound secret scan
#         entry: ./leakhound.sh dir . --engines gitleaks --format sarif --fail-on high --quiet
#         language: system
#         pass_filenames: false
#         always_run: true
